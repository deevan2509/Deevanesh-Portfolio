---
import SectionHeading from './SectionHeading.astro';
import { leadership } from '../data/portfolio';
---

<SectionHeading
  id="leadership"
  title="Leadership & Activities"
  subtitle="Community, university, and national-level roles beyond the classroom."
>
  <div class="space-y-5">
    {
      leadership.map((item) => (
        <details class="group rounded-2xl border border-beige bg-white shadow-sm">
          <summary class="cursor-pointer list-none px-6 py-5 [&::-webkit-details-marker]:hidden">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h3 class="text-lg font-semibold text-charcoal">{item.role}</h3>
                <p class="mt-1 text-sm font-medium text-accent">{item.organization}</p>
                <p class="text-sm text-muted">
                  {[item.location, item.period].filter(Boolean).join(' · ')}
                </p>
              </div>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-muted group-open:text-accent sm:mt-0">
                <span class="group-open:hidden">Show details</span>
                <span class="hidden group-open:inline">Hide details</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 transition-transform group-open:rotate-180"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </div>
          </summary>
          <div class="border-t border-beige px-6 pb-6 pt-2">
            <ul class="space-y-2">
              {item.highlights.map((highlight) => (
                <li class="flex gap-3 text-sm leading-relaxed text-muted">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                  {highlight}
                </li>
              ))}
            </ul>
          </div>
        </details>
      ))
    }
  </div>
</SectionHeading>
