---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/portfolio';
---

<SectionHeading
  id="projects"
  title="Projects"
  subtitle="Selected academic and professional projects showcasing full-stack, AI, and ML work."
>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <article class="flex flex-col rounded-2xl border border-beige bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <h3 class="text-lg font-semibold text-charcoal">{project.name}</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {project.technologies.map((tech) => (
              <span class="rounded-full bg-beige px-3 py-1 text-xs font-medium text-charcoal">
                {tech}
              </span>
            ))}
          </div>
          <ul class="mt-5 flex-1 space-y-2">
            {project.highlights.map((item) => (
              <li class="flex gap-2 text-sm leading-relaxed text-muted">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</SectionHeading>
