---
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<section id={id} class="py-20 md:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mb-12">
      <h2 class="text-3xl font-semibold tracking-tight text-charcoal md:text-4xl">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-3 max-w-2xl text-lg text-muted">{subtitle}</p>
      )}
      <div class="mt-4 h-1 w-12 rounded-full bg-accent"></div>
    </div>
    <slot />
  </div>
</section>
