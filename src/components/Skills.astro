---
import SectionHeading from './SectionHeading.astro';
import { skillGroups } from '../data/portfolio';
---

<SectionHeading
  id="skills"
  title="Technical Skills"
  subtitle="Technologies and tools I use across development, testing, and AI projects."
>
  <div class="grid gap-6 sm:grid-cols-2">
    {
      skillGroups.map((group) => (
        <div class="rounded-2xl border border-beige bg-white p-6 shadow-sm">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-accent">
            {group.category}
          </h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <span class="rounded-lg bg-beige/70 px-3 py-1.5 text-sm text-charcoal">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</SectionHeading>
